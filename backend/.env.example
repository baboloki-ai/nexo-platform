# NEXO backend environment — placeholders only.
# Copy to backend/.env and fill in local values. Never commit real secrets.
# Do not put any of these values in frontend code.

# Required.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nexo
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required in production for ops driver/vehicle verification and wallet top-up:
#   POST /internal/drivers/{id}/verification
#   POST /internal/vehicles/{id}/verification
#   POST /internal/drivers/{id}/wallet/credit
# Header: X-NEXO-INTERNAL-SECRET
# When unset, those endpoints return 404. They are not public self-approve
# or self-credit APIs. Local pytest uses monkeypatched secrets and may
# write verification_status only in the dedicated test database.
# Placeholder only — never put a real secret in this file.
NEXO_INTERNAL_VERIFY_SECRET=

# Optional. Defaults shown.
# RIDE_OFFER_TTL_SECONDS=300
# RIDE_OFFER_EXPIRY_SWEEP_INTERVAL_SECONDS=30
# NEXO_BASE_FARE=20
# NEXO_FARE_PER_KM=2.50

# Optional. Web Push (VAPID) for driver OS notifications when the browser
# tab is backgrounded. Never put VAPID_PRIVATE_KEY in frontend or Vite env.
# When unset, WebSocket and GET /drivers/requests polling continue as before.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=mailto:nexo@localhost

# Password reset email delivery.
# Required in production. Never put SMTP credentials in frontend code.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_USE_TLS=true
# FRONTEND_URL=https://your-production-frontend.example
